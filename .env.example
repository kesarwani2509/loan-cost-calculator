# Copy to .env.local. Never commit real credentials.
# Supabase project URL and public anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Evon-compatible chat completion endpoint (provider contract must match client).
EVON_API_BASE_URL=
EVON_API_KEY=

# Vachana Prisma speech-to-text endpoint / key.
PRISMA_API_BASE_URL=https://api.vachana.ai/stt/v3
PRISMA_API_KEY=

# Vachana Timbre text-to-speech endpoint / key.
TIMBRE_API_BASE_URL=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_API_KEY=
TIMBRE_MODEL=timbre-v2.5

# OpenAI-compatible vision endpoint / key.
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
